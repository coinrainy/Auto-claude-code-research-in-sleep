+        "macro_f1": float(f1_score(y_true, prediction, average="macro", zero_division=0)),
+    }
+
+
+def label_classification(embeddings, y, split_seed: int, classifier_seed: int | None = None) -> dict[str, Any]:
+    """Evaluate one embedding with validation-selected linear classification."""
+
+    if classifier_seed is None:
+        classifier_seed = split_seed
+
+    X = normalize(embeddings.detach().cpu().numpy(), norm="l2").astype(np.float64, copy=False)
+    labels = y.detach().cpu().numpy().astype(np.int64, copy=False)
+    train, validation, test = stratified_indices(labels, split_seed)
+
+    best: dict[str, Any] | None = None
+    best_estimator: OneVsRestClassifier | None = None
+    validation_rows: list[dict[str, float | int]] = []
+    for exponent in C_EXPONENTS:
+        estimator = _classifier(exponent, classifier_seed + exponent)
+        estimator.fit(X[train], labels[train])
+        prediction = estimator.predict(X[validation])
+        row: dict[str, float | int] = {
+            "C_exponent": int(exponent),
+            **_metrics(labels[validation], prediction),
+        }
+        validation_rows.append(row)
+        if best is None or (-row["accuracy"], row["C_exponent"]) < (
+            -best["accuracy"], best["C_exponent"]
+        ):
+            best = row
+            best_estimator = estimator
+
+    if best is None or best_estimator is None:
+        raise RuntimeError("validation-selected linear classifier failed")
+
+    test_prediction = best_estimator.predict(X[test])
+    test_metrics = _metrics(labels[test], test_prediction)
+    combined = np.concatenate((train, np.asarray([-1]), validation, np.asarray([-2]), test))
+    result: dict[str, Any] = {
+        "protocol": "fit_train_select_C_on_validation_then_evaluate_selected_classifier_on_80_percent_test",
+        "split": "stratified_1_1_8",
+        "split_seed": int(split_seed),
+        "classifier_seed": int(classifier_seed),
+        "sizes": {
+            "total": int(labels.size),
+            "train": int(train.size),
+            "validation": int(validation.size),
+            "test": int(test.size),
+        },
+        "split_sha256": _sha256_indices(combined),
+        "train_sha256": _sha256_indices(train),
+        "validation_sha256": _sha256_indices(validation),
+        "test_sha256": _sha256_indices(test),
+        "selected_C_exponent": int(best["C_exponent"]),
+        "selected_C": float(2.0 ** int(best["C_exponent"])),
+        "validation": best,
+        "test": test_metrics,
+        "validation_candidates": validation_rows,
+        "test_labels_used_by_classifier_only": True,
+        "test_accessed": True,
     }
+    return result
+
+
+def summarize(results: list[dict[str, Any]]) -> dict[str, Any]:
+    """Aggregate run-level metrics without rounding away precision."""
+
+    if not results:
+        raise ValueError("cannot summarize an empty result list")
+
+    def stats(values: list[float]) -> dict[str, float]:
+        array = np.asarray(values, dtype=np.float64)
+        return {
+            "mean": float(array.mean()),
+            "std": float(array.std(ddof=0)),
+            "mean_percent": float(array.mean() * 100.0),
+            "std_percent": float(array.std(ddof=0) * 100.0),
+        }
+
+    metrics = ("accuracy", "micro_f1", "macro_f1")
+
+    def evaluation(row: dict[str, Any]) -> dict[str, Any]:
+        # `train.py` stores the evaluator payload under `evaluation`; keeping
+        # this helper tolerant of a bare evaluator row makes the aggregator
+        # useful in small standalone checks too.
+        return row.get("evaluation", row)
+
+    return {
+        "runs": len(results),
+        "test": {
+            metric: stats([float(evaluation(row)["test"][metric]) for row in results])
+            for metric in metrics
+        },
+        "validation": {
+            metric: stats([float(evaluation(row)["validation"][metric]) for row in results])
+            for metric in metrics
+        },
+    }
+
+
+def print_statistics(summary: dict[str, Any]) -> None:

+def _sha256_indices(indices: np.ndarray) -> str:
+    values = np.asarray(indices, dtype=np.int64)
+    return hashlib.sha256(values.tobytes()).hexdigest()
+
+
+def stratified_indices(y: np.ndarray, seed: int) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
+    """Return a deterministic class-wise 1:1:8 split of all nodes."""
+
+    labels = np.asarray(y, dtype=np.int64)
+    rng = np.random.default_rng(seed)
+    train_parts: list[np.ndarray] = []
+    validation_parts: list[np.ndarray] = []
+    test_parts: list[np.ndarray] = []
+
+    for class_id in np.unique(labels):
+        indices = np.flatnonzero(labels == class_id).astype(np.int64, copy=False)
+        rng.shuffle(indices)
+        count = round(0.1 * indices.size)
+        if count < 1:
+            raise RuntimeError(f"class {class_id} is too small for a 1:1:8 split")
+        train_parts.append(indices[:count])
+        validation_parts.append(indices[count : 2 * count])
+        test_parts.append(indices[2 * count :])
+
+    train = np.concatenate(train_parts)
+    validation = np.concatenate(validation_parts)
+    test = np.concatenate(test_parts)
+    rng.shuffle(train)
+    rng.shuffle(validation)
+    rng.shuffle(test)
+    return train, validation, test
+
+
+def _classifier(c_exponent: int, seed: int) -> OneVsRestClassifier:
+    return OneVsRestClassifier(
+        LogisticRegression(
+            C=2.0**c_exponent,
+            solver="liblinear",
+            penalty="l2",
+            max_iter=2000,
+            random_state=int(seed % (2**32 - 1)),
+        ),
+        n_jobs=1,
+    )


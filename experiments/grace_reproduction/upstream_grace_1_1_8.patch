--- a/model.py
+++ b/model.py
@@ -99,6 +99,51 @@ class Model(torch.nn.Module):

         return torch.cat(losses)

+    def batched_semi_loss_chunk(self, z1: torch.Tensor, z2: torch.Tensor,
+                                start: int, batch_size: int) -> torch.Tensor:
+        """Compute one batch without retaining the other batch graphs."""
+        device = z1.device
+        num_nodes = z1.size(0)
+        end = min(start + batch_size, num_nodes)
+        indices = torch.arange(start, end, device=device)
+        f = lambda x: torch.exp(x / self.tau)
+        refl_sim = f(self.sim(z1[indices], z1))
+        between_sim = f(self.sim(z1[indices], z2))
+        positive = between_sim[:, start:end].diag()
+        return -torch.log(
+            positive
+            / (refl_sim.sum(1) + between_sim.sum(1) - refl_sim[:, start:end].diag())
+        )
+
+    def loss_backward(self, z1: torch.Tensor, z2: torch.Tensor,
+                      batch_size: int) -> float:
+        """Backpropagate batched InfoNCE one chunk at a time.
+
+        This is algebraically the same mean as ``loss(..., batch_size=...)``;
+        only the autograd lifetime changes, which is required for the large
+        Coauthor Physics graph.
+        """
+        if batch_size <= 0:
+            raise ValueError("loss_backward requires a positive batch_size")
+
+        h1 = self.projection(z1)
+        h2 = self.projection(z2)
+        num_nodes = h1.size(0)
+        starts = list(range(0, num_nodes, batch_size))
+        total = 0.0
+        num_chunks = 2 * len(starts)
+        chunk_index = 0
+        for anchor, target in ((h1, h2), (h2, h1)):
+            for start in starts:
+                chunk = self.batched_semi_loss_chunk(anchor, target, start, batch_size)
+                chunk_sum = chunk.sum()
+                chunk_index += 1
+                scaled = chunk_sum * (0.5 / num_nodes)
+                scaled.backward(retain_graph=chunk_index < num_chunks)
+                total += float(chunk_sum.detach().item())
+
+        return total / (2.0 * num_nodes)
+
     def loss(self, z1: torch.Tensor, z2: torch.Tensor,
              mean: bool = True, batch_size: int = 0):
         h1 = self.projection(z1)
